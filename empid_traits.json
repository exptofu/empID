{
  "categories": [
    {
      "name": "Crown shape",
      "values": [
        "round",
        "peaked",
        "flat",
        "crested"
      ],
      "description": "The contour and fullness of the crown, from smooth or rounded to peaked or crested."
    },
    {
      "name": "Forehead angle",
      "values": [
        "shallow",
        "medium",
        "steep"
      ],
      "description": "The slope from the bill base up into the crown."
    },
    {
      "name": "Bill length",
      "values": [
        "short",
        "medium",
        "long"
      ],
      "description": "The bill length relative to the bird's head and overall body size."
    },
    {
      "name": "Lower mandible",
      "values": [
        "all dark",
        "partial",
        "all orange/yellow"
      ],
      "description": "The visible color pattern along the lower half of the bill."
    },
    {
      "name": "Tail length",
      "values": [
        "short",
        "medium",
        "long"
      ],
      "description": "The tail length relative to the body, from short to long."
    },
    {
      "name": "Tail width",
      "values": [
        "wide",
        "medium",
        "narrow"
      ],
      "description": "The apparent breadth of the tail when viewed from below or behind."
    },
    {
      "name": "Primary projection",
      "values": [
        "short",
        "medium",
        "long"
      ],
      "description": "How far the folded primary feathers extend beyond the tertials."
    },
    {
      "name": "Wingbar contrast",
      "values": [
        "strong",
        "medium",
        "weak"
      ],
      "description": "How strongly the pale wingbars stand out against the darker wing."
    },
    {
      "name": "Wing panel contrast",
      "values": [
        "strong",
        "medium",
        "weak"
      ],
      "description": "How strongly the paler area across the folded wing stands out."
    },
    {
      "name": "Eye-ring",
      "values": [
        "indistinct",
        "messy, distinct",
        "bold, crisp",
        "tear-shaped"
      ],
      "description": "The shape, sharpness, and distinctness of the pale feathers around the eye."
    },
    {
      "name": "Upper/underpart contrast",
      "values": [
        "strong",
        "medium",
        "weak"
      ],
      "description": "The contrast between the bird's darker upperparts and lighter underparts."
    },
    {
      "name": "Wing flicking",
      "values": [
        "often",
        "occasional",
        "rarely"
      ],
      "description": "How frequently the bird flicks or snaps its wings while perched."
    },
    {
      "name": "Tail flicking",
      "values": [
        "often",
        "occasional",
        "rarely",
        "tail dropping"
      ],
      "description": "How frequently the bird flicks, dips, or drops its tail while perched."
    },
    {
      "name": "P6 emargination",
      "values": [
        "not emarginated",
        "emarginated"
      ],
      "description": "Whether the outer edge of the sixth primary feather (P6) has a notch, called an emargination."
    }
  ],
